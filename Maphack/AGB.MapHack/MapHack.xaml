<Window x:Class="AGB.MapHack.MapHack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AGB.MapHack v0.4.0" Height="600" Width="475" WindowStyle="SingleBorderWindow" Loaded="Window_Loaded" Closed="Window_Closed" Background="LightGray" WindowStartupLocation="CenterScreen">
    <Canvas Name="MapCanvas">
        <RichTextBox Canvas.Left="8" Canvas.Top="8" Height="116" Name="Output" Width="437" Background="Black"></RichTextBox>
        
        <GroupBox Canvas.Left="8" Canvas.Top="131" Header="Settings" Height="214" Name="groupBox1" Width="437" />
        
        <ComboBox Canvas.Left="97" Canvas.Top="425" Height="21" Name="Processes" Width="348" />
        <Button Height="99" Name="Start" Click="Attach_Click" Canvas.Left="8" Canvas.Top="452" Width="437">Attach</Button>
        
        <Grid Canvas.Left="-7" Canvas.Top="152" Height="176" Name="grid1" Width="437">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="39"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"></ColumnDefinition>
                <ColumnDefinition Width="327*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Foreground="Black">
                AGB Username
            </Label>
            <TextBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Height="19" Name="Username" Width="120">Username</TextBox>

            <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Foreground="Black">
                AGB Password
            </Label>
            <PasswordBox Grid.Row="1" Grid.Column="1"  HorizontalAlignment="Left" Height="19" Name="Password" Width="120" Password="password"/>

            <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Foreground="Black">
                Window size
            </Label>
            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="1, 0, 0, 0" Height="19" Name="WindowSizeX" Width="49">125</TextBox>
            <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="49, 3, 0, 0" Foreground="Black">
                by
            </Label>
            <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="71,0,0,0" Height="19" Name="WindowSizeY" Width="49">125</TextBox>
            <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="125, 0, 0, 0" Foreground="Black">
                (min: 100x100; max: 800x600)
            </Label>

            <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Foreground="Black">
                Refresh rate
            </Label>
            <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="1, 0, 0, 0" Height="19" Name="RefreshPause" Width="30">100</TextBox>
            <Label Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="28, 0, 0, 0" Foreground="Black">
                (ms between refreshes, must be greater than 25)
            </Label>

            <Label Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right" Foreground="Black">
                Auto teleport
            </Label>
            
            <CheckBox Grid.Row="4" Grid.Column="2" Margin="1, 0, 0, 0" Name="AutoTeleEnabled" VerticalAlignment="Center">Enable</CheckBox>
            <ComboBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" Margin="70, 0, 0, 0" Height="19" Name="AutoTeleHotkey" Width="100" />

            <Button Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Canvas.Left="26" Canvas.Top="376" Height="23" Name="Save" Width="75" Click="Save_Click">Save settings</Button>
        </Grid>
        <Label Canvas.Left="5" Canvas.Top="423" Height="28" Name="label1" Width="97">Diablo 2 window</Label>
    </Canvas>
</Window>
